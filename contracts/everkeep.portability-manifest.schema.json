{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.portability-manifest.schema.json",
  "title": "Everkeep Portability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportId", "capsuleId", "createdAt", "exportFormat", "authorityState", "integrityState", "portable", "entries", "evidenceRefs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "exportId": {"type": "string", "minLength": 1},
    "capsuleId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "exportFormat": {"type": "string", "minLength": 1},
    "authorityState": {"enum": ["pass", "fail", "unknown"]},
    "integrityState": {"enum": ["verified", "failed", "unknown"]},
    "portable": {"type": "boolean"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "contentDigest"],
        "properties": {
          "resourceId": {"type": "string", "minLength": 1},
          "contentDigest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 16}
            }
          }
        }
      }
    },
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": ["string", "null"]}
  }
}
