{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.recovery-plan.schema.json",
  "title": "Everkeep Recovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "createdAt", "mode", "targetResourceIds", "steps", "requiredGates", "sourceMutationAllowed"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "planId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["dry-run", "sandbox", "restore"]},
    "targetResourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requestedRecoveryPointIds": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "order", "resourceId", "operation", "dependsOn", "targetMode"],
        "properties": {
          "stepId": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "resourceId": {"type": "string", "minLength": 1},
          "operation": {"enum": ["validate", "stage", "restore", "verify"]},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "targetMode": {"enum": ["none", "isolated", "production"]}
        }
      }
    },
    "requiredGates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity-authorized",
          "privacy-authorized",
          "wardveil-clear",
          "recovery-evidence-current",
          "recovery-point-eligible",
          "dependencies-ready",
          "key-material-ready"
        ]
      }
    },
    "sourceMutationAllowed": {"const": false},
    "promotionRequired": {"type": "boolean"}
  }
}
