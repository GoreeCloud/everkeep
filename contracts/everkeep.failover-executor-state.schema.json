{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.failover-executor-state.schema.json",
  "title": "Everkeep Controlled Failover Executor State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionId",
    "requestId",
    "approvalId",
    "planId",
    "planDigest",
    "objectiveId",
    "mode",
    "target",
    "expectedRevision",
    "state",
    "currentStepIndex",
    "completedStepIds",
    "evidenceRefs",
    "updatedAt",
    "simulationOnly",
    "externalEffectsAuthorized",
    "sourceMutationAllowed",
    "trafficMutationAllowed",
    "credentialsEmbedded"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "executionId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "approvalId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectiveId": {"type": "string", "minLength": 1},
    "mode": {"const": "drill"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "environment", "failureDomain"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "failureDomain": {"type": "string", "minLength": 1}
      }
    },
    "expectedRevision": {"type": "string", "minLength": 1},
    "state": {"enum": ["pending", "validating", "authorized", "staging", "executing", "verifying", "completed", "blocked", "failed", "cancelled"]},
    "currentStepIndex": {"type": "integer", "minimum": 0},
    "completedStepIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": ["string", "null"], "format": "date-time"},
    "simulationOnly": {"const": true},
    "externalEffectsAuthorized": {"const": false},
    "sourceMutationAllowed": {"const": false},
    "trafficMutationAllowed": {"const": false},
    "credentialsEmbedded": {"const": false}
  }
}
