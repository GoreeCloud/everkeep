{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/continuity.status.schema.json",
  "title": "GoreeCloud Continuity Status Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "producer",
    "scope",
    "dimension",
    "state",
    "observed_at",
    "required_evidence",
    "verification_method"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "dimension": {
      "type": "string",
      "enum": [
        "backup_coverage",
        "restore_capability",
        "recovery_freshness",
        "portability",
        "migration",
        "dependency_recovery",
        "redundancy",
        "documentation",
        "ownership_custody",
        "succession",
        "preservation",
        "provenance"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "attention",
        "degraded",
        "unknown",
        "not_applicable"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fresh_until": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "required_evidence": {
      "type": "boolean"
    },
    "verification_method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "evidence_reference": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 25
    }
  }
}
