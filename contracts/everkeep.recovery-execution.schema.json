{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.recovery-execution.schema.json",
  "title": "Everkeep Recovery Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionId", "planId", "state", "environment", "authorized", "sourceMutationAllowed", "gateResults", "evidenceRefs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "executionId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "state": {"enum": ["pending", "authorized", "running", "verifying", "completed", "blocked", "failed", "cancelled"]},
    "environment": {"type": "string", "minLength": 1},
    "authorized": {"type": "boolean"},
    "sourceMutationAllowed": {"const": false},
    "gateResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "privacy", "wardveil", "evidence", "recoveryPoint", "dependencies", "keyMaterial"],
      "properties": {
        "identity": {"$ref": "#/$defs/gate"},
        "privacy": {"$ref": "#/$defs/gate"},
        "wardveil": {"$ref": "#/$defs/gate"},
        "evidence": {"$ref": "#/$defs/gate"},
        "recoveryPoint": {"$ref": "#/$defs/gate"},
        "dependencies": {"$ref": "#/$defs/gate"},
        "keyMaterial": {"$ref": "#/$defs/gate"}
      }
    },
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "finishedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unknown"]},
        "evidenceRef": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
