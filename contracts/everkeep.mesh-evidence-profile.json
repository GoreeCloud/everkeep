{
  "schema_version": "1.1.0",
  "system": "everkeep",
  "producer_repository": "GoreeCloud/goreecloud-everkeep",
  "authority_domains": ["resilience", "recovery", "preservation", "continuity"],
  "mesh_envelope": {
    "version": "goreecloud.evidence-envelope.v1",
    "repository": "GoreeCloud/goreecloud-mesh",
    "path": "contracts/mesh.evidence-envelope.schema.json"
  },
  "platform_evidence_plane": {
    "contract": "goreecloud.platform-evidence-plane.v1",
    "repository": "GoreeCloud/goreecloud-mesh",
    "path": "contracts/mesh.platform-evidence-plane.v1.json",
    "authority_transfer": false
  },
  "presentation_consumer": {
    "system": "glaze-ui",
    "repository": "GoreeCloud/glaze-ui",
    "path": "contracts/glaze.evidence-presentation.schema.json",
    "may_upgrade_continuity_truth": false
  },
  "runtime_delivery": {
    "producer_service_id": "everkeep",
    "write_scope": "mesh.evidence.write",
    "read_scope": "mesh.evidence.read",
    "delivery_client": "runtime/mesh_delivery.py",
    "producer_identity_must_match_envelope": true,
    "https_required_except_loopback": true,
    "credential_issuer": "GoreeCloud Identity",
    "production_acceptance": false
  },
  "producer_contracts": [
    "contracts/everkeep.evidence.schema.json",
    "contracts/everkeep.recovery-point.schema.json",
    "contracts/everkeep.protection-policy.schema.json",
    "contracts/everkeep.resource.schema.json"
  ],
  "permitted_assertion_families": [
    "protection-evidence",
    "recovery-point-state",
    "integrity-verification",
    "restore-verification",
    "recovery-readiness",
    "retention-compliance",
    "rpo-compliance",
    "rto-readiness",
    "copy-assurance",
    "dependency-readiness",
    "continuity-readiness",
    "preservation-integrity",
    "portability-readiness",
    "succession-readiness"
  ],
  "minimization": {
    "allowed_data_classes": ["public", "operational", "derived"],
    "raw_backup_content": "prohibited",
    "archive_or_snapshot_payloads": "prohibited",
    "credentials_keys_tokens": "prohibited",
    "private_file_or_message_content": "prohibited",
    "preferred_content": "resource-scoped derived readiness, verification results, reason codes, recovery-point metadata, freshness, opaque evidence references, and optional digests"
  },
  "authority_rules": [
    "Everkeep remains authoritative for resilience, recovery, preservation, continuity, portability, and succession evidence.",
    "Mesh may persist and transport bounded Everkeep evidence but cannot convert backup existence into verified recoverability.",
    "Privacy Shield remains authoritative for retention, deletion, export, and succession privacy authority that constrains Everkeep actions.",
    "Wardveil remains authoritative for security findings used during recovery or post-restore verification.",
    "Glaze UI may present Everkeep evidence but cannot create, upgrade, or merge resilience, recovery, preservation, or continuity truth.",
    "A valid Mesh envelope is not by itself recovery-ready evidence; the applicable Everkeep contract must also pass."
  ],
  "status": "source-profile",
  "production_acceptance": false
}
