{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/continuity.adoption.schema.json",
  "title": "Everkeep Adoption Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "role",
    "dimensions",
    "read_only",
    "fail_closed",
    "status_schema"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1, "maxLength": 160},
    "repository": {"type": ["string", "null"], "maxLength": 240},
    "role": {
      "type": "string",
      "enum": ["producer", "consumer", "producer_consumer"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "backup_coverage",
          "restore_capability",
          "recovery_freshness",
          "portability",
          "migration",
          "dependency_recovery",
          "redundancy",
          "documentation",
          "ownership_custody",
          "succession",
          "preservation",
          "provenance"
        ]
      }
    },
    "read_only": {"type": "boolean", "const": true},
    "fail_closed": {"type": "boolean", "const": true},
    "status_schema": {
      "type": "string",
      "const": "contracts/continuity.status.schema.json"
    },
    "authoritative_sources": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "notes": {"type": ["string", "null"], "maxLength": 1000}
  }
}
