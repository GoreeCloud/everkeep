{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.recovery-topology.schema.json",
  "title": "Everkeep Recovery Topology Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "topologyId", "scope", "observedAt", "authoritative", "nodes", "edges", "recoveryTargets", "evidenceRefs", "sensitivePayloadsExcluded"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "topologyId": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "observedAt": {"type": "string", "format": "date-time"},
    "authoritative": {"type": "boolean"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "nodeType", "state"],
        "properties": {
          "nodeId": {"type": "string", "minLength": 1},
          "nodeType": {"enum": ["service", "data-store", "storage", "compute", "network", "dns", "identity", "key-material", "provider", "region", "other"]},
          "state": {"enum": ["ready", "degraded", "unavailable", "unknown"]},
          "failureDomain": {"type": ["string", "null"]},
          "displayName": {"type": ["string", "null"]},
          "evidenceRef": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceNodeId", "targetNodeId", "relationship"],
        "properties": {
          "sourceNodeId": {"type": "string", "minLength": 1},
          "targetNodeId": {"type": "string", "minLength": 1},
          "relationship": {"enum": ["depends-on", "hosted-in", "uses", "replicates-to", "recovers-from", "routes-through"]}
        }
      }
    },
    "recoveryTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "environment", "state", "failureDomain", "supportsNodeIds", "evidenceRef"],
        "properties": {
          "targetId": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "state": {"enum": ["ready", "degraded", "unavailable", "unknown"]},
          "failureDomain": {"type": "string", "minLength": 1},
          "supportsNodeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidenceRef": {"type": ["string", "null"]}
        }
      }
    },
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sensitivePayloadsExcluded": {"const": true}
  }
}
