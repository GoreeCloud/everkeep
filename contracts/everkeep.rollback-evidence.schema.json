{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.rollback-evidence.schema.json",
  "title": "Everkeep Rollback Assurance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rollbackEvidenceId", "rollbackPlanId", "executionId", "planId", "planDigest", "objectiveId", "targetId", "environment", "expectedRevision", "observedRevision", "evaluatedAt", "state", "authoritative", "exactRevisionBound", "checks", "evidenceRefs", "simulationOnly", "externalEffectsObserved", "productionMutationAuthorized"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "rollbackEvidenceId": {"type": "string", "minLength": 1},
    "rollbackPlanId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectiveId": {"type": "string", "minLength": 1},
    "targetId": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "expectedRevision": {"type": "string", "minLength": 1},
    "observedRevision": {"type": "string", "minLength": 1},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["pass", "fail", "unknown"]},
    "authoritative": {"type": "boolean"},
    "exactRevisionBound": {"type": "boolean"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceHealth", "dataIntegrity", "dependencies", "security", "privacy"],
      "properties": {
        "serviceHealth": {"$ref": "#/$defs/check"},
        "dataIntegrity": {"$ref": "#/$defs/check"},
        "dependencies": {"$ref": "#/$defs/check"},
        "security": {"$ref": "#/$defs/check"},
        "privacy": {"$ref": "#/$defs/check"}
      }
    },
    "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "simulationOnly": {"const": true},
    "externalEffectsObserved": {"const": false},
    "productionMutationAuthorized": {"const": false}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority", "evidenceRef"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unknown"]},
        "authority": {"type": "string", "minLength": 1},
        "evidenceRef": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
