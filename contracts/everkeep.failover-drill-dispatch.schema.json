{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.failover-drill-dispatch.schema.json",
  "title": "Everkeep Failover Drill Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dispatchId", "requestId", "executionId", "planId", "planDigest", "objectiveId", "target", "expectedRevision", "state", "requestedAt", "evidenceRefs", "simulationOnly", "externalEffectsAuthorized", "sourceMutationAllowed", "trafficMutationAllowed", "credentialsEmbedded"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "dispatchId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectiveId": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "environment", "failureDomain"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "failureDomain": {"type": "string", "minLength": 1}
      }
    },
    "expectedRevision": {"type": "string", "minLength": 1},
    "state": {"enum": ["accepted", "blocked"]},
    "requestedAt": {"type": "string", "format": "date-time"},
    "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "simulationOnly": {"const": true},
    "externalEffectsAuthorized": {"const": false},
    "sourceMutationAllowed": {"const": false},
    "trafficMutationAllowed": {"const": false},
    "credentialsEmbedded": {"const": false}
  }
}
