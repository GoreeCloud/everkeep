{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.failover-executor-request.schema.json",
  "title": "Everkeep Failover Executor Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "approvalId",
    "planId",
    "planDigest",
    "objectiveId",
    "mode",
    "target",
    "expectedRevision",
    "requestedAt",
    "approvalExpiresAt",
    "gateResults",
    "evidenceRefs",
    "handoffAccepted",
    "simulationOnly",
    "externalEffectsAuthorized",
    "sourceMutationAllowed",
    "trafficMutationAllowed",
    "credentialsEmbedded"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "requestId": {"type": "string", "minLength": 1},
    "approvalId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectiveId": {"type": "string", "minLength": 1},
    "mode": {"const": "drill"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "environment", "failureDomain"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "failureDomain": {"type": "string", "minLength": 1}
      }
    },
    "expectedRevision": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string", "format": "date-time"},
    "approvalExpiresAt": {"type": "string", "format": "date-time"},
    "gateResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "privacy", "wardveil", "continuity", "target", "dependencies", "keyMaterial"],
      "properties": {
        "identity": {"$ref": "#/$defs/gate"},
        "privacy": {"$ref": "#/$defs/gate"},
        "wardveil": {"$ref": "#/$defs/gate"},
        "continuity": {"$ref": "#/$defs/gate"},
        "target": {"$ref": "#/$defs/gate"},
        "dependencies": {"$ref": "#/$defs/gate"},
        "keyMaterial": {"$ref": "#/$defs/gate"}
      }
    },
    "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "handoffAccepted": {"type": "boolean"},
    "simulationOnly": {"const": true},
    "externalEffectsAuthorized": {"const": false},
    "sourceMutationAllowed": {"const": false},
    "trafficMutationAllowed": {"const": false},
    "credentialsEmbedded": {"const": false}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority", "evidenceRef", "observedAt", "validUntil"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unknown"]},
        "authority": {"type": "string", "minLength": 1},
        "evidenceRef": {"type": ["string", "null"]},
        "observedAt": {"type": ["string", "null"], "format": "date-time"},
        "validUntil": {"type": ["string", "null"], "format": "date-time"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
