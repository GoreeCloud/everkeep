{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/contracts/everkeep.recovery-action.schema.json",
  "title": "Everkeep Recovery Center Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "resourceId", "reason", "authorizedByEvidence"],
  "properties": {
    "action": {
      "enum": [
        "protect-resource",
        "browse-recovery-points",
        "verify-integrity",
        "run-restore-test",
        "inspect-policy",
        "inspect-key-readiness",
        "inspect-dependencies",
        "inspect-continuity-objective",
        "run-disaster-recovery-drill",
        "inspect-failure-domains",
        "inspect-alternate-recovery-target",
        "inspect-recovery-topology",
        "inspect-continuity-assurance",
        "evaluate-continuity-now",
        "create-failover-plan",
        "review-failover-approval",
        "inspect-failover-denial",
        "evaluate-failover-acceptance",
        "inspect-failover-drill",
        "inspect-failover-drill-blocker",
        "review-rollback-assurance",
        "create-recovery-plan",
        "run-recovery-sandbox",
        "restore-resource",
        "create-preservation-capsule",
        "export-resource"
      ]
    },
    "resourceId": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "authorizedByEvidence": {"type": "boolean"},
    "destructive": {"type": "boolean", "default": false}
  }
}
