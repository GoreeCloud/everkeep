{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.local/schemas/everkeep.mesh.event.schema.json",
  "title": "Everkeep Mesh Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "resourceId", "occurredAt", "status"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "minLength": 8},
    "eventType": {
      "enum": [
        "protection.completed", "protection.failed", "verification.completed", "integrity.warning",
        "recovery_point.created", "recovery_point.expired", "restore_test.passed", "restore_test.failed",
        "recovery.started", "recovery.completed", "recovery.failed", "policy.violation",
        "archive.health_changed", "succession.state_changed", "readiness.changed"
      ]
    },
    "resourceId": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "warning", "failure", "pending"]},
    "requestId": {"type": "string"},
    "policyId": {"type": "string"},
    "recoveryPointId": {"type": "string"},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "details": {"type": "object"}
  }
}
