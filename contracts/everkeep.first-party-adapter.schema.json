{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/everkeep/contracts/everkeep.first-party-adapter.schema.json",
  "title": "Everkeep First-Party Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapterId", "application", "resourceClasses", "capabilities", "cursorMode"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "adapterId": {"type": "string", "minLength": 1},
    "application": {"type": "string", "enum": ["goreecloud-drive", "goreecloud-documents", "goreecloud-photos", "goreecloud-vault", "goreecloud-backup"]},
    "resourceClasses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discover", "snapshot", "restore", "verify", "export"],
      "properties": {
        "discover": {"type": "boolean"},
        "snapshot": {"type": "boolean"},
        "restore": {"type": "boolean"},
        "verify": {"type": "boolean"},
        "export": {"type": "boolean"},
        "pointInTime": {"type": "boolean"},
        "versionHistory": {"type": "boolean"}
      }
    },
    "cursorMode": {"type": "string", "enum": ["none", "opaque", "sequence", "timestamp"]},
    "requiredPermissions": {"type": "array", "items": {"type": "string"}},
    "privacyPurposes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
